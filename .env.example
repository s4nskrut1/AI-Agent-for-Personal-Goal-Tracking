# GoalMate Environment Configuration

# Optional: Add any of your favorite LLM API keys below.
# GoalMate includes an autonomous offline fallback engine, so the app will
# function fully even if no API key is set!

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional fast inference)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Custom DB Path (Defaults to data/goalmate.db)
# GOALMATE_DB_PATH=data/goalmate.db
